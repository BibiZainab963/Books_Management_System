<%- include("partials/header", { title: "Library" }) %>
<section class="page-intro"><div><span class="eyebrow">THE COMPLETE COLLECTION</span><h1>Your <em>library.</em></h1><p>Browse every title in your collection. Search by title, author, category or book ID.</p></div><a class="btn btn-primary intro-button" href="/insert">＋ Add book</a></section>
<section class="panel library-panel">
  <form class="filter-bar" method="get" action="/list">
    <label class="search-field"><span>⌕</span><input name="search" value="<%= search %>" placeholder="Search books, authors or IDs…"></label>
    <label class="filter-select"><span>Category</span><select name="category" onchange="this.form.submit()"><option value="">All categories</option><% categories.forEach(c => { %><option value="<%= c %>" <%= selectedCategory === c ? 'selected' : '' %>><%= c %></option><% }) %></select></label>
    <button class="btn btn-primary" type="submit">Search</button><a class="btn btn-outline" href="/list">Reset</a>
  </form>
  <div class="table-top"><div><strong><%= books.length %></strong> book records found</div><span>Connected to your MySQL table</span></div>
  <% if (!books.length) { %><div class="empty-state compact"><div class="empty-icon">⌕</div><h3>No books found</h3><p>Try another search or clear the filters.</p><a class="btn btn-outline" href="/list">Clear filters</a></div><% } else { %>
  <div class="table-wrap"><table><thead><tr><th>BOOK</th><th>AUTHOR</th><th>CATEGORY</th><th>PRICE</th><th>STOCK</th><th>ACTIONS</th></tr></thead><tbody>
  <% books.forEach((b, i) => { %><tr><td><div class="table-book"><span class="mini-cover cover-<%= i % 4 %>">Z</span><span><strong><%= b.title %></strong><small>ID #<%= b.book_id %></small></span></div></td><td><%= b.author %></td><td><span class="category-pill"><%= b.category %></span></td><td class="price-cell">₹<%= Number(b.price).toLocaleString("en-IN", {maximumFractionDigits:2}) %></td><td><span class="stock-status <%= Number(b.stock) === 0 ? 'out' : '' %>"><%= Number(b.stock) === 0 ? 'Out of stock' : b.stock + ' copies' %></span></td><td><div class="row-actions"><a title="View" href="/listOne?id=<%= b.book_id %>">↗</a><a title="Edit" href="/update?id=<%= b.book_id %>">✎</a><a title="Delete" class="delete-action" href="/delete?id=<%= b.book_id %>">×</a></div></td></tr><% }) %>
  </tbody></table></div><% } %>
</section>
<%- include("partials/footer") %>
