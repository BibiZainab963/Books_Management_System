<%- include("partials/header", { title: "Find One Book" }) %>
<section class="page-intro"><div><span class="eyebrow">BOOK LOOKUP</span><h1>Find one <em>book.</em></h1><p>Select a book from your existing records. Its details appear automatically below.</p></div></section>
<section class="panel selector-panel"><form method="get" action="/listOne" class="selector-form"><label class="field">Choose a book <span class="required">*</span><select name="id" required><option value="">Select a book by title and ID…</option><% books.forEach(b => { %><option value="<%= b.book_id %>" <%= selectedId === String(b.book_id) ? 'selected' : '' %>><%= b.title %> — <%= b.author %> (ID #<%= b.book_id %>)</option><% }) %></select></label><button class="btn btn-primary" type="submit">Show details <span>↗</span></button></form></section>
<% if (selected) { %><section class="detail-card"><div class="detail-cover cover-2"><span class="cover-deco">✧</span><span class="cover-title"><%= selected.title %></span><span class="cover-author"><%= selected.author %></span><span class="cover-bottom">ZAINAB BOOKS</span></div><div class="detail-content"><span class="category-pill"><%= selected.category %></span><h2><%= selected.title %></h2><p class="detail-author">Written by <strong><%= selected.author %></strong></p><div class="detail-fields"><div><small>BOOK ID</small><strong>#<%= selected.book_id %></strong></div><div><small>PRICE</small><strong>₹<%= Number(selected.price).toLocaleString("en-IN", {maximumFractionDigits:2}) %></strong></div><div><small>STOCK</small><strong><%= selected.stock %> copies</strong></div><div><small>AVAILABILITY</small><strong class="<%= Number(selected.stock) === 0 ? 'text-danger' : 'text-green' %>"><%= Number(selected.stock) === 0 ? 'Out of stock' : 'Available' %></strong></div></div><div class="form-actions"><a class="btn btn-outline" href="/update?id=<%= selected.book_id %>">✎ Edit details</a><a class="btn btn-primary" href="/delete?id=<%= selected.book_id %>">Manage book ↗</a></div></div></section><% } else if (!books.length) { %><div class="empty-state"><h3>No books to display yet</h3><p>Add a book first, then select it here.</p><a class="btn btn-primary" href="/insert">＋ Add book</a></div><% } else { %><div class="hint-card"><span>✧</span><div><strong>Your book details will appear here</strong><p>Use the dropdown above to choose any book already saved in your database.</p></div></div><% } %>
<%- include("partials/footer") %>
