<%- include("partials/header", { title: "Update Book" }) %>
<section class="page-intro"><div><span class="eyebrow">KEEP YOUR RECORDS CURRENT</span><h1>Update a <em>book.</em></h1><p>Choose an existing book. The saved information will fill in automatically for editing.</p></div><div class="intro-stamp">EDIT<br><span>MODE</span></div></section>
<section class="panel selector-panel"><form method="post" action="/update/select" class="selector-form"><label class="field">Select existing book <span class="required">*</span><select name="book_id" required><option value="">Choose title, author and ID…</option><% books.forEach(b => { %><option value="<%= b.book_id %>" <%= selectedId === String(b.book_id) ? 'selected' : '' %>><%= b.title %> — <%= b.author %> (ID #<%= b.book_id %>)</option><% }) %></select></label><button class="btn btn-primary" type="submit">Load book <span>↓</span></button></form></section>
<% if (selected || (formBook && formBook.title)) { %><section class="panel form-panel"><div class="panel-heading"><span class="panel-icon">↻</span><div><h2>Edit book information</h2><p>Book ID: #<%= selected ? selected.book_id : selectedId %> · Existing details loaded</p></div></div><form method="post" action="/update"><input type="hidden" name="book_id" value="<%= selected ? selected.book_id : selectedId %>"><%- include("partials/book-form", { formBook }) %><div class="form-actions"><a class="btn btn-outline" href="/update">Cancel</a><button class="btn btn-primary" type="submit">Save changes <span>↗</span></button></div></form></section><% } else if (!books.length) { %><div class="empty-state"><h3>No books to update</h3><p>Your database does not have any book records yet.</p><a class="btn btn-primary" href="/insert">＋ Add a book</a></div><% } else { %><div class="hint-card"><span>↻</span><div><strong>Choose a book to begin</strong><p>Once selected, its current values will be loaded into the form. No need to type the old details again.</p></div></div><% } %>
<%- include("partials/footer") %>
