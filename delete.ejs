<%- include("partials/header", { title: "Delete Book" }) %>
<section class="page-intro"><div><span class="eyebrow">CURATE YOUR SHELVES</span><h1>Remove a <em>book.</em></h1><p>Select a saved book from the dropdown. Review its details before confirming deletion.</p></div><div class="intro-stamp danger-stamp">REMOVE<br><span>ENTRY</span></div></section>
<section class="panel selector-panel delete-selector"><form method="post" action="/delete/select" class="selector-form"><label class="field">Choose book to remove <span class="required">*</span><select name="book_id" required><option value="">Select a title — no typing needed…</option><% books.forEach(b => { %><option value="<%= b.book_id %>" <%= selectedId === String(b.book_id) ? 'selected' : '' %>><%= b.title %> — <%= b.author %> (ID #<%= b.book_id %>)</option><% }) %></select></label><button class="btn btn-primary" type="submit">Review selection <span>↓</span></button></form></section>
<% if (selected) { %><section class="delete-review"><div class="warning-icon">!</div><div class="delete-review-copy"><span class="eyebrow">PLEASE REVIEW</span><h2><%= selected.title %></h2><p>by <%= selected.author %></p><div class="review-tags"><span>ID #<%= selected.book_id %></span><span><%= selected.category %></span><span>₹<%= Number(selected.price).toLocaleString("en-IN", {maximumFractionDigits:2}) %></span><span><%= selected.stock %> copies</span></div><p class="delete-warning">Deleting this record removes it from your MySQL <code>books</code> table. This action cannot be undone.</p><form method="post" action="/delete" data-confirm="Delete “<%= selected.title %>” permanently? This cannot be undone."><input type="hidden" name="book_id" value="<%= selected.book_id %>"><div class="form-actions"><a class="btn btn-outline" href="/delete">Keep book</a><button class="btn btn-danger" type="submit">Delete this book <span>×</span></button></div></form></div></section><% } else if (!books.length) { %><div class="empty-state"><h3>Your library is empty</h3><p>There are no records available to delete.</p><a class="btn btn-primary" href="/insert">＋ Add a book</a></div><% } else { %><div class="hint-card warning-hint"><span>!</span><div><strong>Nothing is deleted yet</strong><p>Select a book and review its details. Deletion only happens after you click the final confirmation button.</p></div></div><% } %>
<section class="panel existing-records"><div class="panel-heading"><span class="panel-icon">▤</span><div><h2>Current books</h2><p>Pick from the records currently stored in your database.</p></div><span class="count-chip"><%= books.length %> books</span></div><div class="compact-book-list"><% books.slice(0, 5).forEach((b, i) => { %><a href="/delete?id=<%= b.book_id %>" class="compact-book-row"><span class="mini-cover cover-<%= i % 4 %>">Z</span><span class="compact-book-title"><strong><%= b.title %></strong><small><%= b.author %> · ID #<%= b.book_id %></small></span><span class="row-arrow">↗</span></a><% }) %><% if (!books.length) { %><p class="muted">No saved books yet.</p><% } %></div><% if (books.length > 5) { %><a class="text-link list-all-link" href="/list">View all <%= books.length %> books ↗</a><% } %></section>
<%- include("partials/footer") %>
